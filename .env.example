POMHUB_ORIGIN=http://localhost:3002
ZIK_ORIGIN=http://localhost:3000
# Match ZIK_POMHUB_CLIENT_SECRET on the Zik server. Never NEXT_PUBLIC_.
ZIK_CLIENT_SECRET=replace-with-random-secret
# Independent from Zik and the client secret; at least 32 random characters.
POMHUB_SESSION_SECRET=replace-with-another-random-secret-at-least-32-characters
